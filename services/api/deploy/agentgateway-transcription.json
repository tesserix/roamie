{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayBackend",
      "metadata": {
        "name": "roamie-api-transcription-vertex",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "ai": {
          "groups": [
            {
              "providers": [
                {
                  "name": "vertex",
                  "policies": {
                    "auth": {
                      "gcp": {}
                    },
                    "tls": {}
                  },
                  "vertexai": {
                    "model": "gemini-3.8-flash",
                    "projectId": "tesseracthub-480811",
                    "region": "global"
                  }
                }
              ]
            }
          ]
        },
        "policies": {
          "ai": {
            "routes": {
              "/v1/transcribe": "Completions"
            }
          }
        }
      }
    },
    {
      "apiVersion": "gateway.networking.k8s.io/v1",
      "kind": "HTTPRoute",
      "metadata": {
        "name": "roamie-api-transcription",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "parentRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "Gateway",
            "name": "roamie-ai",
            "sectionName": "http"
          }
        ],
        "rules": [
          {
            "backendRefs": [
              {
                "group": "agentgateway.dev",
                "kind": "AgentgatewayBackend",
                "name": "roamie-api-transcription-vertex",
                "weight": 1
              }
            ],
            "filters": [
              {
                "requestHeaderModifier": {
                  "remove": [
                    "Authorization",
                    "Cookie",
                    "X-Roamie-AI-Service",
                    "X-Roamie-AI-Capability",
                    "X-Roamie-User-Id"
                  ],
                  "set": [
                    {
                      "name": "Accept-Encoding",
                      "value": "identity"
                    }
                  ]
                },
                "type": "RequestHeaderModifier"
              }
            ],
            "matches": [
              {
                "path": {
                  "type": "Exact",
                  "value": "/v1/transcribe"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "roamie-api-transcription-auth",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "HTTPRoute",
            "name": "roamie-api-transcription"
          }
        ],
        "traffic": {
          "authorization": {
            "action": "Require",
            "policy": {
              "matchExpressions": [
                "request.method == \"POST\" && jwt.client_id in [\"392328865646707494\", \"392328864774226726\"]"
              ]
            }
          },
          "jwtAuthentication": {
            "mode": "Strict",
            "providers": [
              {
                "audiences": [
                  "392328861469115174"
                ],
                "issuer": "https://auth.tesserix.app",
                "jwks": {
                  "remote": {
                    "backendRef": {
                      "group": "agentgateway.dev",
                      "kind": "AgentgatewayBackend",
                      "name": "roamie-api-jwks",
                      "port": 443
                    },
                    "cacheDuration": "5m",
                    "jwksPath": "/oauth/v2/keys"
                  }
                }
              }
            ]
          },
          "rateLimit": {
            "local": [
              {
                "burst": 20,
                "requests": 120,
                "unit": "Minutes"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "agentgateway.dev/v1alpha1",
      "kind": "AgentgatewayPolicy",
      "metadata": {
        "name": "roamie-api-transcription-traffic",
        "namespace": "agentgateway-system"
      },
      "spec": {
        "backend": {
          "ai": {
            "promptGuard": {
              "request": [
                {
                  "regex": {
                    "action": "Reject",
                    "builtins": [
                      "CreditCard",
                      "Ssn"
                    ]
                  },
                  "response": {
                    "message": "Remove sensitive identifiers before trying again.",
                    "statusCode": 400
                  }
                }
              ]
            }
          }
        },
        "targetRefs": [
          {
            "group": "gateway.networking.k8s.io",
            "kind": "HTTPRoute",
            "name": "roamie-api-transcription"
          }
        ],
        "traffic": {
          "authorization": {
            "action": "Require",
            "policy": {
              "matchExpressions": [
                "json(request.body).model == \"roamie-transcription\" && request.headers[\"x-roamie-ai-capability\"] == \"talk/turn\""
              ]
            }
          },
          "buffer": {
            "request": {
              "failureMode": "FailClosed",
              "maxBytes": "12Mi"
            }
          },
          "timeouts": {
            "request": "45s"
          },
          "transformation": {
            "request": {
              "metadata": {
                "ledger_capability": "\"x-roamie-ai-capability\" in request.headers ? request.headers[\"x-roamie-ai-capability\"] : \"\"",
                "ledger_user": "jwt.sub"
              }
            }
          }
        }
      }
    }
  ]
}
